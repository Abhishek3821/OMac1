# Optional EmailJS configuration. If these are omitted, the form uses FormSubmit.
# Create an EmailJS template whose recipient is ceo@omacinvestigations.com and whose
# variables include: from_name, from_email, phone, service, message, and reply_to.
REACT_APP_EMAILJS_SERVICE_ID=service_xxxxxxx
REACT_APP_EMAILJS_TEMPLATE_ID=template_xxxxxxx
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key
